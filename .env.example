# --- Shopify (Storefront API) -------------------------------------------------
# Sans ces deux valeurs, le site tourne sur le catalogue de démonstration.
# Shopify admin › Paramètres › Applications et canaux de vente › Headless › Storefront API
SHOPIFY_STORE_DOMAIN=lovelyhop.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Clé de signature d'un webhook créé à la main (Paramètres › Notifications › Webhooks). Inutile pour
# ceux de scripts/shopify-webhooks.mjs, signés avec SHOPIFY_ADMIN_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=
# App « Lovelyhop site CPE » du Dev Dashboard (dev.shopify.com), droits read_customers + write_customers :
# enregistre les demandes de soumission CPE comme clients. ID client et secret client de la page Aperçu de l'app.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Ou, à la place, le jeton fixe d'une ancienne app personnalisée.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Mesure d'audience (PostHog), chargée seulement après accord dans le bandeau de témoins ------
# Jeton public du projet « Lovelyhop » (us.posthog.com, projet 561487) ; vide = aucune mesure.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Site ----------------------------------------------------------------------
# En production : https://lovelyhop.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Courriel public du service à la clientèle (JSON-LD Organization), facultatif
NEXT_PUBLIC_CONTACT_EMAIL=

# Compte client sur le site (Customer Account API, canal Headless → API de compte client, client public).
# Dans Shopify : URI de rappel https://<site>/api/auth/callback, origine https://<site>, URI de déconnexion https://<site>/api/auth/logged-out.
# AUTH_SECRET : chaîne aléatoire (openssl rand -base64 48) qui chiffre le cookie de session.
SHOPIFY_CUSTOMER_CLIENT_ID=
AUTH_SECRET=

# --- Soumissions CPE (courriel via Resend), facultatif --------------------------
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL="Lovelyhop <soumissions@lovelyhop.com>"
